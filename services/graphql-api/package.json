{
  "name": "graphql-api",
  "version": "1.0.0",
  "description": "GraphQL API server for Fund My Cause with contract data caching and real-time subscriptions",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docs": "tsx scripts/generate-schema-docs.ts",
    "docs:generate": "tsx scripts/generate-schema-docs.ts",
    "schema:export": "tsx scripts/export-schema.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "artillery run load-test.yml",
    "test:load:report": "artillery run load-test.yml --output load-report.json && artillery report load-report.json",
    "test:load:smoke": "artillery run load-test-smoke.yml"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@fund-my-cause/rpc-client": "file:../../packages/rpc-client",
    "@fund-my-cause/sdk": "file:../../sdks/js",
    "@fund-my-cause/shared-utils": "file:../../packages/shared-utils",
    "@fund-my-cause/types": "file:../../packages/types",
    "@graphql-tools/schema": "^9.0.19",
    "@graphql-tools/utils": "^10.0.0",
    "@stellar/stellar-sdk": "14.6.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "graphql": "^16.8.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^5.14.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "rate-limiter-flexible": "^2.4.1",
    "redis": "^4.6.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.1.0",
    "artillery": "^2.0.33",
    "ts-node": "^10.9.0",
    "tsx": "^4.6.0",
    "typescript": "^5.9.0",
    "vitest": "^1.1.0"
  }
}
