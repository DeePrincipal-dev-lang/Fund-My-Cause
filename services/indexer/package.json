{
  "name": "indexer-service",
  "version": "0.1.0",
  "description": "Off-chain indexer service for Fund-My-Cause contract events",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "test:unit": "vitest run --exclude \"src/**/*.integration.test.ts\"",
    "test:integration": "vitest run src/**/*.integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "lint": "eslint src",
    "health": "curl http://localhost:3001/health"
  },
  "dependencies": {
    "@fund-my-cause/rpc-client": "file:../../packages/rpc-client",
    "@fund-my-cause/shared-utils": "file:../../packages/shared-utils",
    "@fund-my-cause/types": "file:../../packages/types",
    "express": "^4.18.2",
    "@stellar/stellar-sdk": "14.6.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "vitest": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  }
}
