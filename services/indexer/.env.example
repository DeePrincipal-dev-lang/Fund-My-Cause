# Indexer Service Environment Configuration

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
CROWDFUND_CONTRACT_ID=
# Optional: also ingest registry contract events (handlers/registry/*, #1125)
REGISTRY_CONTRACT_ID=
# Optional: ingest quadratic-funding calculation events (handlers/qf/*)
QF_CONTRACT_ID=
# Optional: ingest achievement contract events (handlers/achievements/*)
ACHIEVEMENTS_CONTRACT_ID=

PORT=3001
LOG_LEVEL=info

# Store capacity (pool-equivalent settings)
# STORE_MAX_EVENT_CAPACITY=100000
# STORE_EVENT_BATCH_SIZE=500
# STORE_STALE_LEDGER_THRESHOLD_MS=60000
# RPC_REQUEST_TIMEOUT_MS=30000
# RPC_MAX_CONCURRENT_REQUESTS=5
# RPC_RETRY_ATTEMPTS=3
