# ============================================
# Fund-My-Cause Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# See docs/environment-config.md for detailed documentation

# ============================================
# Contract Addresses
# ============================================
# Crowdfund contract address
# Note: the app currently resolves the contract via NEXT_PUBLIC_CONTRACT_ID /
# NEXT_PUBLIC_CAMPAIGN_CONTRACT_IDS below; these two keys are kept because
# scripts/check-env-parity.js requires them in every .env.* file.
NEXT_PUBLIC_CROWDFUND_CONTRACT_ID=

# Registry contract address
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=

# Crowdfund contract the UI reads (apps/interface/src/lib/constants.ts)
NEXT_PUBLIC_CONTRACT_ID=

# Optional extra campaign contracts, comma-separated
# (apps/interface/src/lib/soroban/client.ts)
NEXT_PUBLIC_CAMPAIGN_CONTRACT_IDS=

# ============================================
# Network Configuration
# ============================================
# mainnet | testnet — drives explorer links and passphrase defaults
# (apps/interface/src/components/ui/TransactionHistory.tsx, src/lib/constants.ts)
NEXT_PUBLIC_NETWORK=testnet

# Soroban RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-mainnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
# Testnet: Test SDF Network ; September 2015
# Mainnet: Public Global Stellar Network ; September 2015
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon REST API endpoint
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ============================================
# GraphQL API
# ============================================
# Base URL of services/graphql-api (the client appends /graphql)
# Default when unset: http://localhost:4000
# (apps/interface/src/lib/graphql/client.ts)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000

# ============================================
# Optional: IPFS Configuration
# ============================================
# Pinata IPFS — get keys at https://app.pinata.cloud/keys
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_API_KEY=

# ============================================
# Optional: Image CDN
# ============================================
# CDN origin for serving responsive images (AVIF/WebP) with long cache headers.
# When set, next/image will serve optimised images through this CDN.
# Example: https://cdn.fund-my-cause.app
# Leave empty to serve images from the Next.js origin (/_next/image).
NEXT_PUBLIC_IMAGE_CDN_URL=

# ============================================
# Optional: Application Features
# ============================================
# Comma-separated list of featured campaign contract IDs
# If unset, the landing page falls back to hardcoded demo campaigns
NEXT_PUBLIC_FEATURED_CAMPAIGNS=

# Enable/disable analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Analytics tracking ID (if enabled)
NEXT_PUBLIC_ANALYTICS_ID=

# ============================================
# Environment
# ============================================
# development | production
NODE_ENV=development
